# Системные файлы Mac и Windows
.DS_Store
Thumbs.db

# Настройки редакторов кода (VS Code, PhpStorm)
.vscode/
.idea/

# Файлы с паролями и секретами (база данных)
.env
config.local.php

# Папка зависимостей Composer (если будете подключать библиотеки)
/vendor/

# Папка с загруженными пользователями фотками (чтобы не забивать репозиторий гигабайтами)
# При этом сам файл .gitkeep останется, чтобы папка существовала
/uploads/*
!/uploads/.gitkeep
